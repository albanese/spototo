[Unit]
Description=Spotify playlist sync for Yoto pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Edit these three paths/user to match your own setup before installing.
User=youruser
WorkingDirectory=/path/to/spototo
EnvironmentFile=/path/to/spototo/.env
ExecStart=/path/to/spototo/spotify_sync/.venv/bin/python \
          /path/to/spototo/spotify_sync/sync.py
StandardOutput=journal
StandardError=journal
