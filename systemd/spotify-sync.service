[Unit]
Description=Spotify playlist sync for Yoto pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yo
WorkingDirectory=/opt/stack/yoto-automation
EnvironmentFile=/opt/stack/yoto-automation/.env
ExecStart=/opt/stack/yoto-automation/spotify_sync/.venv/bin/python \
          /opt/stack/yoto-automation/spotify_sync/sync.py
StandardOutput=journal
StandardError=journal
